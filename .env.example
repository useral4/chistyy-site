PUBLIC_URL=https://kinavapro.ru
# Test API only. Shop ID is provided by the owner; confirm it is a test shop.
YOOKASSA_MODE=test
YOOKASSA_SHOP_ID=1485993
YOOKASSA_SECRET_KEY=
# Persistent paths outside public/ on a Russian server for actual contact data.
LEADS_DIR=/var/lib/kinavapro/leads
REPORTS_DIR=/var/lib/kinavapro/reports
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LEADS_EMAIL=
METRIKA_ID=
YANDEX_VERIFICATION=
TRUST_PROXY=1
# Fresh isolated browser checks are enabled by default. Disable only for constrained hosts.
BROWSER_AUDIT=on
# Leave unset on the current single-process installation until data is migrated.
DATABASE_URL=
# Private VPS worker. Set both values; never expose its port to the Internet.
BROWSER_WORKER_URL=
BROWSER_WORKER_KEY=
# Set to 1 on the VPS to reject incomplete audits instead of silently omitting the browser stage.
BROWSER_REQUIRED=0
# Random secret, at least 32 characters. Metrics are unavailable when this is empty.
METRICS_TOKEN=
# VPS operations notifications. Leave empty until the operator chooses a recipient.
OPS_EMAIL=
OPS_DIR=/var/lib/kinavapro/operations
